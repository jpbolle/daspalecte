# Configuration Firebase cote navigateur (valeurs publiques, pas des secrets)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Mettre a "true" pour taper sur les emulateurs locaux au lieu du projet reel
NEXT_PUBLIC_USE_FIREBASE_EMULATORS=false

# Compte promu administrateur a son premier login
ADMIN_EMAIL=jeanphilippe.bolle@cnddinant.be

# Clients OAuth autorises a appeler /api/ingest, separes par des virgules.
# Ne JAMAIS verifier un token contre un client ID en dur : cette liste permet
# d'ajouter un client (extension, add-on, app web) sans toucher au code.
ALLOWED_AUDIENCES=

# Origines autorisees a appeler /api/ingest (extension Chrome), separees par des virgules.
# Format : chrome-extension://<id de l'extension>
# Il y en a deux : l'extension publiee sur le Web Store, et la copie non
# empaquetee utilisee en developpement, qui a un identifiant different.
ALLOWED_INGEST_ORIGINS=
